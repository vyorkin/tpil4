section

variable (a b c d : ℝ) (f g u v : ℝ → ℝ)

-- grind
--
-- Закрывает цель целиком, не трансформируя её в другую.
--
-- Под капотом:
--      переписывание леммами
--    + прямой вывод из гипотез
--    + разбор случаев (cases)
--    + конгруэнтное замыкание
--
-- Что закрывает (аннотации объясняют почему):
--   ⊢ a + 0 = a                       -- встроенные леммы арифметики (@[grind] Nat.add_zero)
--   h : a = b  ⊢ a + c = b + c        -- локальные гипотезы подхватываются автоматически
--   ⊢ (if b then 1 else 2) = ...      -- сам делает cases b, не нужен split
--   h1:a=b, h2:c=d    ⊢ a+c=b+d       -- "конгруэнтное замыкание": граф равенств видит цепочку
--   hac:a≤c, hbd:b≤d  ⊢ a+b≤c+d       -- арифметические неравенства
--   ⊢ xs ++ [] = xs                   -- леммы помеченные @[grind] (List.append_nil и др.)
--
-- "Конгруэнтное замыкание" — это алгоритм, который
-- из набора известных равенств автоматически выводит все следствия по правилу:
-- если аргументы равны, то результаты функции тоже равны.
--
-- Правило конгруэнтности (оно одно):
--     a = b
-- ───────────────
--   f(a) = f(b)
--
-- Что не умеет: индукцию.
-- если цель требует induction — сначала induction/cases вручную, затем grind на подцелях.
--
-- Отличие от omega:
--   omega решает только линейную арифметику (Nat/Int).
--   grind шире: равенства, Bool, List, произвольные теоремы через @[grind].

-- grind vs omega vs aesop — когда что использовать
--
-- Как устроен каждый механизм внутри:
--
-- omega —
--   Решатель одного конкретного фрагмента (линейная арифметика ℕ/ℤ).
--   Напрямую вычисляет ответ по алгоритму.
--   Если omega не смогла — цель точно не следует из линейной арифметики.
--
--
-- grind —
--    переписывание леммами
--  + вывод из гипотез + разбор случаев (if/match/Bool)
--  + конгруэнтное замыкание
--
--  Всё за один проход, без отката назад.
--  Если ни один из этих шагов не продвигает цель — завершается ошибкой.
--
--
-- aesop —
--   Перебор применений тактик (apply, intro, cases, constructor, simp, exact)
--   в глубину, с откатом назад, если выбранный путь зашёл в тупик.
--   Это единственная из трёх, которая пробует разные пути и возвращается, если один не сошёлся.
--
-- Ниже — проверенные вручную результаты
-- на конкретных целях, чтобы не гадать по описанию:
--
--   задача                                                   grind  omega  aesop
--   ──────────────────────────────────────────────────────────────────────────
--   n - m + m = n, при m ≤ n              (monus)              ✓      ✓      ✓
--   n % 2 = 0 ∨ n % 2 = 1                 (mod)                ✓      ✓      ✗
--   a=b, c=d  ⊢  a+c=b+d                  (конгруэнтность)     ✓      ✓      ✓
--   a≤c, b≤d  ⊢  a+b≤c+d                  (неравенства)        ✓      ✓      ✗
--   h : P ∧ Q  ⊢  Q ∧ P                   (пропозиц. логика)   ✓      ✗      ✓
--   ⊢ ∃ k, n = k                          (тривиальный ∃)      ✓      ✗      ✓
--   xs ++ [] = xs                         (список)             ✓      ✗      ✓
--   (if b then n+1 else n+2) > n          (Bool, разбор b)     ✓      ✗      ✓
--   n < 4  ⊢  n=0 ∨ n=1 ∨ n=2 ∨ n=3       (перебор случаев)    ✓      ✓      ✗
--   n * m = m * n                         (нелинейно)          ✓      ✗      ✗
--   x≤y, y<5  ⊢  x<5     (x y : ℝ)        (не ℕ/ℤ)             ✓      ✗      ✗
--   double n = 2*n, double — рекурсия     (нужна индукция)     ✗      ✗      ✗
--
-- (if b then n+1 else n+2) > n — специально не тривиальный if: если взять
-- (if b then 1 else 2) = (if b then 1 else 2), обе стороны буквально совпадают
-- и это доказывается рефлексивностью, независимо от того, кто умеет делать
-- cases b, а кто нет — такой пример ничего не показывает.
--
-- double n = 2*n — единственная строка, где все три тактики отказали:
-- double определена рекурсивно (double 0 = 0, double (n+1) = double n + 2),
-- и чтобы связать double n с n при произвольном n, нужна индукция по n.
-- Ни grind, ни omega, ни aesop её не делают. Решение — вручную:
--
--   induction n with
--   | zero => grind [double]
--   | succ n ih => grind [double]
--
-- где сначала induction/cases разбивает n на случаи, а дальше на каждой
-- подцели уже работает grind (можно и omega — по ситуации).
--
-- Правило, с чего начинать:
--
-- 1. Цель — чистая линейная арифметика ℕ/ℤ (неравенства, mod, div, monus)
--    → omega первым: единственная из трёх с гарантией полноты (fail ⟺ недоказуемо),
--    и не зависит от того, какие леммы сейчас помечены @[grind]/@[aesop].
-- 2. omega не подошла (или цель шире — if/List/Bool/произвольные @[grind]-леммы,
--    цепочки равенств и неравенств из нескольких гипотез)
--    → grind: закрывает почти всё то же, что omega, и добавляет сверху
--    конгруэнтное замыкание и разбор случаев.
-- 3. Цель логическая — ∧, ∨, ∃, конструкторы структур, нужно применить
--    несколько лемм подряд в разном порядке, часть из них — @[aesop]
--    → aesop: единственная из трёх, кто перебирает пути и откатывается.
-- 4. Ни одна тактика не берёт цель, а в контексте — рекурсивно определённая
--    функция или утверждение "для всех n" про её значения
--    → нужна ручная induction/cases, затем grind/omega на подцелях.
--
-- Итак в порядке возрастания "мощности" тактик:
-- omega, grind, aesop, induction/cases

example (a : Nat) : a + 0 = a := by
  grind  -- знает Nat.add_zero

example (a b : Nat) : a + b = b + a := by
  grind  -- знает Nat.add_comm

example (h : a = b) : a + c = b + c := by
  grind  -- умеет использовать локальные гипотезы автоматически

-- Разбор случаев (if, match)
example (b : Bool) : (if b then 1 else 2) = (if b then 1 else 2) := by
  grind  -- автоматически делает cases b

example (xs : List Nat) : xs ++ [] = xs := by
  grind  -- использует List.append_nil (леммы @[grind])

-- Прямой вывод и "конгруэнтное замыкание".
-- grind строит граф равенств и видит, что a=b, c=d влечёт a+c=b+d
example (a b c d : Nat) (h1 : a = b) (h2 : c = d) : a + c = b + d := by
  grind

-- С неравенствами: из a ≤ c, b ≤ d следует a+b ≤ c+d
example (a b c d : Nat) (hac : a ≤ c) (hbd : b ≤ d) : a + b ≤ c + d := by
  grind

end



-- symm

-- Тактика symm меняет местами левую и правую части отношения, которое
-- является симметричным. Чаще всего ей пользуются для
-- равенства = и логической равносильности ↔, но она работает с любым
-- отношением, для которого объявлена лемма симметричности, помеченная
-- атрибутом @[symm]
--
-- атрибут @[symm] — это реестр лемм, который тактика symm перебирает,
-- чтобы найти подходящее правило переворота для отношения в
-- цели или гипотезе. Без него тактика не знает, как «развернуть»
-- нестандартное отношение.

-- Пример 1: symm переворачивает цель-равенство
example (a b : Nat) (h : a = b) : b = a := by
  symm -- цель меняется с  b = a  на  a = b
  exact h

-- Пример 2: symm на гипотезе (модификатор at)
example (a b : Nat) (h : b = a) : a = b := by
  symm at h -- h : b = a  становится  h : a = b
  exact h

-- Пример 3: symm с логической равносильностью ↔
example (P Q : Prop) (h : P ↔ Q) : Q ↔ P := by
  symm -- цель  Q ↔ P  переворачивается в  P ↔ Q
  exact h

-- Пример 4: пользовательское отношение, помеченное @[symm]
-- чтобы symm умел переворачивать R, нужно зарегистрировать
-- лемму симметричности атрибутом @[symm]
def MyRel (a b : Nat) : Prop := a + b = b + a

@[symm]
theorem myRel_symm {a b : Nat} (_ : MyRel a b) : MyRel b a := Nat.add_comm b a

example (a b : Nat) (h : MyRel a b) : MyRel b a := by
  symm -- работает, потому что myRel_symm помечена @[symm]
  exact h

-- suffices
--
-- suffices `h : p` говорит: "достаточно доказать p, чтобы закрыть текущую цель".
-- Она кладёт `h : p` в контекст и первым делом требует закрыть С ЭТИМ h исходную цель.
-- Только после этого остаётся вторая, отдельная задача — доказать сам p.
--
-- Порядок целей обратный по сравнению с have. have h : p сначала требует
-- доказать p, и только потом даёт h : p для исходной цели. suffices сначала
-- даёт h : p для исходной цели, а доказательство p откладывает на потом.
--
-- Синтаксис:
--   suffices h : p by tac   — сразу закрывает исходную цель тактикой tac
--                              (внутри tac уже виден h : p); дальше остаётся
--                              только цель ⊢ p
--   suffices h : p           — то же самое, но без by: получаются два bullet-а,
--                              первый — исходная цель с h : p в контексте,
--                              второй — ⊢ p
--   suffices : p by tac      — без имени, h называется this
--   suffices h : p from e    — e — готовый терм, доказывающий исходную цель
--                              (используя h); эквивалент suffices h : p by exact e
--
-- Когда полезно: когда доказательство того, что "p достаточно" — короткое,
-- а доказательство самого p — длинное. suffices даёт сначала показать
-- короткий шаг сведения, а объёмную часть доказательства оставить на потом,
-- не теряя из виду, зачем она вообще нужна.

-- пример 1: базовая форма с by — сводим n * n = 16 к n = 4
example (n : ℕ) (h : n = 4) : n * n = 16 := by
  suffices hn : n = 4 by
    rw [hn]
  exact h

-- пример 2: без by — два bullet-а. первый закрывает исходную цель,
-- используя hn : n = 4 (она уже в контексте); второй доказывает саму hn.
example (n : ℕ) (h : n = 4) : n * n = 16 := by
  suffices hn : n = 4
  · rw [hn]
  · exact h

-- для сравнения — тот же результат через have: порядок целей обратный.
-- первый bullet доказывает саму hn, второй — использует её для исходной цели.
example (n : ℕ) (h : n = 4) : n * n = 16 := by
  have hn : n = 4
  · exact h
  · rw [hn]

-- пример 3: suffices без имени — гипотеза называется this
example (n : ℕ) (h : n = 4) : n * n = 16 := by
  suffices n = 4 by rw [this]
  exact h

-- пример 4: from — готовый терм вместо блока by
example (n : ℕ) (h : n = 4) : n * n = 16 := by
  suffices hn : n = 4 from hn ▸ rfl
  exact h

-- пример 5: типичная идиома — доказать более сильный факт, который тривиально
-- даёт нужный. вместо x ≠ 0 напрямую доказываем 0 < x — для этого есть
-- готовая лемма hx, а от 0 < x до x ≠ 0 добраться одной леммой ne_of_gt
example (x : ℝ) (hx : 0 < x) : x ≠ 0 := by
  suffices h : 0 < x by exact ne_of_gt h
  exact hx

-- subst
--
-- subst h — убирает локальную переменную из контекста,
-- заменяя все её вхождения (в цели и во всех гипотезах) на другую сторону равенства h,
-- а затем удаляет и саму переменную, и гипотезу h.
--
-- Ограничение: ровно одна из сторон равенства h должна быть
-- локальной переменной (введённой через fun / have / intro и т.п.),
-- а не произвольным составным выражением вроде n + 1.
-- если обе стороны — выражения, subst откажет — используй rw в таких случаях.
--
-- Синтаксис:
--   subst h         — h : x = e  или  h : e = x  (x — локальная переменная)
--   subst x         — x — имя переменной; lean ищет подходящую гипотезу сам
--   subst h₁ h₂ …   — несколько подстановок за раз (применяются слева направо)
--
-- Что происходит с контекстом (h : x = e):
--
--   до:                         после:
--   ──────────────────────────  ──────────────────────────
--   x : T                       (x удалён)
--   h : x = e                   (h удалён)
--   другая_h : P x              другая_h : P e
--   ⊢ Q x                       ⊢ Q e
--
-- subst vs rw:
--   rw [h]   — переписывает вхождения x на e в цели (или в гипотезе),
--              но x и h остаются в контексте
--   subst h  — переписывает везде (цель + все гипотезы) и полностью
--              удаляет x и h; строже по требованиям, зато оставляет
--              более чистый контекст

-- пример 1: простейший случай — h : x = e
example (x : ℕ) (h : x = 5) : x + 1 = 6 := by
  subst h   -- x заменяется на 5, цель становится 5 + 1 = 6
  rfl

-- пример 2: обратный порядок равенства — h : e = x тоже работает
example (x : ℕ) (h : 5 = x) : x + 1 = 6 := by
  subst h   -- lean понимает, что x — переменная, и заменяет x на 5
  rfl

-- пример 3: subst переписывает и в других гипотезах, не только в цели
-- это ключевое отличие от rw: rw [h] затрагивает только цель
example (x y : ℕ) (h : x = y) (hx : x > 0) : y > 0 := by
  subst h   -- h : x = y → x заменяется на y везде; hx : x > 0 → hx : y > 0
  exact hx  -- цель y > 0 закрывается напрямую

-- пример 4: subst по имени переменной (lean ищет гипотезу сам)
example (a b : ℕ) (h : a = b) : a + a = b + b := by
  subst a   -- lean находит h : a = b, заменяет a → b
  rfl       -- цель b + b = b + b

-- пример 5: несколько подстановок за раз
-- subst h₁ h₂ эквивалентно subst h₁; subst h₂
example (a b c : ℕ) (h₁ : a = 1) (h₂ : b = 2) : a + b = c → c = 3 := by
  subst h₁ h₂  -- a → 1, b → 2; цель: 1 + 2 = c → c = 3
  intro h
  omega

-- пример 6: subst после получения равенства через pattern match или rcases
-- p — локальная переменная, поэтому subst применим
example (p : ℕ × ℕ) (h : p = (1, 2)) : p.1 + p.2 = 3 := by
  subst h  -- p заменяется на (1, 2), цель: (1, 2).1 + (1, 2).2 = 3
  rfl

-- пример 7: ограничение — subst не работает с составными выражениями
--
-- следующий код не скомпилируется:
--   example (n : ℕ) (h : n + 1 = 3) : n = 2 := by
--     subst h   -- ошибка: "n + 1" — не локальная переменная
--
-- причина: lean не может "уничтожить" выражение n + 1 как переменную.
-- в таких случаях используй omega, linarith или rw:
example (n : ℕ) (h : n + 1 = 3) : n = 2 := by
  omega

-- order
--
-- order — тактика из Mathlib для автоматического доказательства целей,
-- которые следуют из аксиом упорядоченности: рефлексивности, транзитивности,
-- антисимметрии и тотальности (для LinearOrder).
--
-- не требует арифметики — работает на любом абстрактном типе с инстансом
-- Preorder, PartialOrder или LinearOrder. это главное отличие от linarith:
-- linarith требует алгебраической структуры (числа), order — нет.
--
-- что умеет:
--   — транзитивность цепочек ≤ и < любой длины
--   — смешанные цепочки (≤ и < вперемешку)
--   — антисимметрия: a ≤ b и b ≤ a → a = b
--   — вывод False из циклического порядка: a < b, b < a
--   — ≥ и > (разворачивает в ≤ и < автоматически)
--   — ¬(a < b) и ¬(a ≤ b) (понимает отрицания неравенств)
--   — min a b ≤ a, min a b ≤ b, a ≤ max a b и т.п.
--   — тотальность: a ≤ b ∨ b ≤ a (из [LinearOrder])
--   — рефлексивность: a ≤ a (без гипотез)
--
-- что не умеет:
--   — арифметику: "n ≤ 3" не даёт "n + 1 ≤ 4" — для этого нужен omega/linarith
--   — нелинейные факты о конкретных числах
--
-- синтаксис:
--   order — доказывает текущую цель (или выводит False из контекста)
--
-- диагностика при неудаче:
--   set_option trace.order true — покажет, что именно order пробовал сделать

-- пример 1: рефлексивность — order доказывает её без гипотез
example {α : Type*} [Preorder α] (a : α) : a ≤ a := by
  order

-- пример 2: транзитивность ≤
example {α : Type*} [Preorder α] (a b c : α) (h₁ : a ≤ b) (h₂ : b ≤ c) : a ≤ c := by
  order

-- пример 3: смешанная цепочка — строгое и нестрогое неравенство вместе
-- order понимает, что < строже ≤, и правильно комбинирует их
example {α : Type*} [Preorder α] (a b c d : α)
    (h₁ : a < b) (h₂ : b ≤ c) (h₃ : c < d) : a < d := by
  order

-- пример 4: антисимметрия → равенство
-- если a ≤ b и b ≤ a одновременно, order выводит a = b
example {α : Type*} [PartialOrder α] (a b : α) (h₁ : a ≤ b) (h₂ : b ≤ a) : a = b := by
  order

-- пример 5: вывод False из циклического порядка
-- order замечает противоречие в контексте и закрывает любую цель
example {α : Type*} [Preorder α] (a b : α) (h₁ : a < b) (h₂ : b < a) : False := by
  order

-- пример 6: отрицания неравенств + ≠ → строгое неравенство
-- order понимает ¬(a < b) как b ≤ a, и из ¬(a < b) + a ≠ b выводит b < a
example {α : Type*} [LinearOrder α] (a b : α) (h₁ : ¬a < b) (h₂ : a ≠ b) : b < a := by
  order

-- пример 7: абстрактный тип — там где linarith бессилен
-- linarith требует числовую структуру (Add, Ring и т.д.)
-- order работает с любым типом, у которого есть только упорядоченность
example {α : Type*} [LinearOrder α] (a b c x : α)
    (h₁ : a ≤ x) (h₂ : x ≤ b) (h₃ : b ≤ c) : a ≤ c := by
  order

-- пример 8: ограничение — арифметика order не понимает
-- следующий код не скомпилируется:
--   example (n : ℕ) (h : n ≤ 3) : n + 1 ≤ 4 := by
--     order   -- ошибка: "No contradiction found"
--             -- order видит n, 3, n+1, 4 как несвязанные элементы,
--             -- он не знает, что прибавление единицы монотонно
-- используй omega или linarith в таких случаях:
example (n : ℕ) (h : n ≤ 3) : n + 1 ≤ 4 := by
  omega

-- induction
--
-- induction — тактика структурной индукции. применяется к переменной
-- индуктивного типа и порождает по одной подцели на каждый конструктор.
-- в рекурсивных ветках автоматически добавляется индукционная гипотеза (ih).
--
-- это главное отличие от cases: cases не даёт ih.
-- cases только разбивает на конструкторы, без возможности использовать
-- утверждение для предшественника.
--
-- синтаксис:
--
--   induction x with
--   | constructor₁ args => ...
--   | constructor₂ args ih => ...
--
-- или альтернативный (точечная нотация):
--
--   induction x
--   · ...   -- первая ветка
--   · ...   -- вторая ветка
--
-- или с case для явного именования:
--
--   induction x
--   case zero => ...
--   case succ n ih => ...
--
-- трансформация целей (для Nat):
--
--   было                    → ветки
--   ──────────────────────────────────────────────
--   ⊢ P n                   → ⊢ P 0
--                             n : Nat, ih : P n ⊢ P (n + 1)
--
-- для List α:
--
--   ⊢ P xs                  → ⊢ P []
--                             hd : α, tl : List α, ih : P tl ⊢ P (hd :: tl)
--
-- induction vs cases:
--   cases  — разбирает конструкторы, ih не добавляет, для разбора структуры
--   induction — разбирает + добавляет ih, для доказательств свойств по индукции
--
-- induction ... using P — использует нестандартный принцип индукции P вместо
-- автоматически выведенного (см. примеры ниже: Nat.le_induction, Nat.mod.inductionOn)

-- пример 1: base — нулевое сложение (0 + n = n)
-- базовый случай — rfl, шаг — rw + ih
example (n : Nat) : 0 + n = n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [Nat.add_succ, ih]

-- пример 2: n + n = 2 * n
-- n + 0 = n тривиально по определению (rfl), поэтому берём цель, которая реально
-- требует индукции: суккессорная ветка использует ih через omega
example (n : Nat) : n + n = 2 * n := by
  induction n with
  | zero => rfl
  | succ n ih => omega

-- пример 3: индукция по List — map сохраняет длину
-- в cons-ветке ih : (tl.map f).length = tl.length используется явно через simp only
example (xs : List Nat) : (xs.map (· + 1)).length = xs.length := by
  induction xs with
  | nil => rfl
  | cons hd tl ih => simp only [List.map_cons, List.length_cons, ih]

-- пример 4: append nil — классический List-индукция с явным rw + ih
example (xs : List Nat) : xs ++ [] = xs := by
  induction xs with
  | nil => rfl
  | cons hd tl ih => rw [List.cons_append, ih]

-- пример 5: n + m = m + n — induction n без generalizing
-- ih : n + m = m + n — только для фиксированного m (m захвачен из контекста)
-- omega видит ih и закрывает суккессорную ветку автоматически
example (n m : Nat) : n + m = m + n := by
  induction n with
  | zero => simp
  | succ n ih => omega

-- пример 6: n + m = m + n — induction n generalizing m
-- ih : ∀ m, n + m = m + n — квантор над m, ih работает для любого m
-- разница заметна в более сложных доказательствах, где m меняется внутри шага
example (n m : Nat) : n + m = m + n := by
  induction n generalizing m with
  | zero => simp
  | succ n ih => omega

-- пример 7: нестандартный принцип индукции — induction ... using
-- Nat.le_induction стартует не с 0, а с произвольного n₀.
-- синтаксис: induction h using Nat.le_induction
-- h : n₀ ≤ m — это «указатель», по которому lean выбирает принцип
example (n : Nat) (h : 2 ≤ n) : 1 ≤ n := by
  induction h with
  | refl => norm_num
  | step h ih => exact Nat.le_step ih

-- пример 8: n * 2 = n + n — явное использование ih через rw
-- суккессорная ветка: rw [Nat.succ_mul] раскрывает (n+1)*2 = n*2 + 2,
-- затем rw [ih] заменяет n*2 на n+n, затем ring закрывает арифметику
example (n : Nat) : n * 2 = n + n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [Nat.succ_mul, ih]; ring

-- пример 9: induction + <;> для единообразных подцелей
-- если обе ветки закрываются одинаково — omega или simp — пишем <;>
-- это компактнее, чем расписывать каждую ветку отдельно
-- здесь omega закрывает и zero (0 + 0 = 0) и succ (n+1+n+1 = 2*(n+1))
example (n : Nat) : n + n = 2 * n := by
  induction n <;> omega

-- funext
--
-- Доказывает цель вида f = g, где f и g — функции,
-- сводя её к поточечному равенству ∀ x, f x = g x.
-- funext x вводит переменную x и меняет цель с f = g на f x = g x —
-- дальше это обычное равенство значений, а не функций.
--
-- Синтаксис:
--   funext x        — снять один слой (для функции одного аргумента)
--   funext x y      — снять два слоя сразу (для каррированной f : α → β → γ)
--   funext x y z …  — по одному имени на каждый аргумент функции
--   funext          — без имён, переменные получают автосгенерированные имена
--
-- Работает только в одну сторону: цель обязана быть равенством функций f = g.
-- Обратный переход — из h : f = g получить f x = g x — funext не нужен,
-- для этого достаточно `rw [h]` или `congrFun h x`.
--
-- Отличие от ext: ext — тактика общего назначения.
-- Для функций она находит и применяет ту же самую лемму funext через реестр @[ext].
-- funext работает только с функциями и не заглядывает в реестр,
-- ext работает ещё и со множествами, подтипами, структурами — везде, где есть @[ext]-лемма.

-- пример 1: базовый случай — равенство функций одного аргумента
example (f g : ℕ → ℕ) (h : ∀ x, f x = g x) : f = g := by
  funext x
  exact h x

-- пример 2: каррированная функция двух аргументов — funext x y снимает
-- оба слоя разом, вместо funext x; funext y по отдельности
example (f g : ℕ → ℕ → ℕ) (h : ∀ x y, f x y = g x y) : f = g := by
  funext x y
  exact h x y

-- пример 3: обратное направление — funext тут не нужен, из h : f = g
-- до f x = g x достаточно rw [h] (или congrFun h x)
example (f g : ℕ → ℕ) (h : f = g) (x : ℕ) : f x = g x := by
  rw [h]

-- пример 4: funext на лямбда-выражениях напрямую, без именованных f g —
-- после funext цель становится обычным арифметическим равенством
example : (fun n : ℕ => n + 0) = fun n => n := by
  funext n
  omega

-- пример 5: то же самое для более сложного тождества — funext сводит
-- равенство функций к равенству многочленов, дальше работает ring
example : (fun n : ℕ => (n + 1) * (n + 1)) = fun n => n * n + 2 * n + 1 := by
  funext n
  ring

-- пример 6: ext вместо funext — для функций делает ровно то же самое,
-- только через общий механизм @[ext], а не напрямую
example (f g : ℕ → ℕ) (h : ∀ x, f x = g x) : f = g := by
  ext x
  exact h x

-- fin_cases
--
-- fin_cases h делает разбор случаев по гипотезе h, у которой конечное число
-- возможных значений, и порождает по одной подцели на каждое конкретное значение.
-- переменная (или сама гипотеза) при этом заменяется на конкретный элемент —
-- как если бы ты вручную подставил каждое значение и получил отдельную цель.
--
-- работает в двух формах:
--   fin_cases h   — h : a ∈ A, где A : Finset X, A : Multiset X или A : List X
--   fin_cases x   — x : A, где для A есть инстанс [Fintype A]
--                          (например x : Fin n, x : Bool)
--
-- синтаксис:
--   fin_cases h          -- h — гипотеза о принадлежности множеству/списку
--   fin_cases x          -- x — переменная конечного типа (Fintype)
--   fin_cases h <;> tac  -- закрыть все порождённые подцели одной тактикой tac
--
-- отличие от cases: cases разбирает конструкторы индуктивного типа,
-- fin_cases — конкретные значения из конечного множества/списка/Fintype.
--
-- отличие от decide: decide проверяет вычислением одну готовую цель целиком,
-- fin_cases сначала разбивает цель на случаи, а дальше каждый случай
-- можно закрывать чем угодно (decide, rfl, norm_num, simp).
--
-- отличие от interval_cases: interval_cases сам находит границы n ≤ x ≤ m
-- по гипотезам контекста, fin_cases требует явного указания источника
-- конечности — готовой гипотезы принадлежности или Fintype-переменной.
--
-- когда применять:
--   1. есть гипотеза h : x ∈ {a, b, c} (Finset/List/Multiset) — и на каждое
--      значение цель доказывается по-своему (или одинаково через <;>)
--   2. есть переменная конечного типа (Fin n, Bool) и утверждение проще
--      проверить переборным способом, чем общим рассуждением
--   3. когда нужно "перечислить" всех кандидатов явно, а не полагаться
--      на общую арифметику (omega/linarith тут не помогут — множество
--      не обязано быть числовым диапазоном)

-- пример 1: простейший случай — членство в явном Finset
-- было:  h : x ∈ {1, 2, 3},  ⊢ x = 1 ∨ x = 2 ∨ x = 3
-- после fin_cases h — три подцели, в каждой x уже заменён на конкретное число:
--   ⊢ 1 = 1 ∨ 1 = 2 ∨ 1 = 3
--   ⊢ 2 = 1 ∨ 2 = 2 ∨ 2 = 3
--   ⊢ 3 = 1 ∨ 3 = 2 ∨ 3 = 3
example (x : ℕ) (h : x ∈ ({1, 2, 3} : Finset ℕ)) : x = 1 ∨ x = 2 ∨ x = 3 := by
  fin_cases h
  · left; rfl
  · right; left; rfl
  · right; right; rfl

-- пример 2: fin_cases сразу на переменной конечного типа (без гипотезы-∈)
-- x : Fin 3 — сам по себе конечный тип (три значения: 0, 1, 2)
-- fin_cases x порождает три подцели, каждую decide закрывает вычислением
example (x : Fin 3) : x.val < 3 := by
  fin_cases x <;> decide

-- пример 3: членство в List вместо Finset — работает точно так же
example (x : ℕ) (h : x ∈ [1, 2, 3]) : x < 4 := by
  fin_cases h <;> decide

-- пример 4: членство в Finset.range n — тоже конечное множество,
-- fin_cases не обязан видеть "красивый" литерал {1, 2, 3}
example (x : ℕ) (h : x ∈ Finset.range 3) : x = 0 ∨ x = 1 ∨ x = 2 := by
  fin_cases h <;> tauto

-- пример 5: <;> норм_num закрывает разные по сложности подцели одной командой
-- после fin_cases h цель "Nat.Prime n" превращается в четыре конкретные:
-- Nat.Prime 2, Nat.Prime 3, Nat.Prime 5, Nat.Prime 7 — norm_num проверяет каждую
example (n : ℕ) (h : n ∈ ({2, 3, 5, 7} : Finset ℕ)) : Nat.Prime n := by
  fin_cases h <;> norm_num

-- пример 6: разные тактики для разных случаев — не всегда <;> подходит
-- когда подцели не единообразны, приходится расписывать каждую ветку отдельно
example (n : ℕ) (h : n ∈ ({0, 1, 4} : Finset ℕ)) :
    n = 0 ∨ ∃ k, n = k ^ 2 ∧ k > 0 := by
  fin_cases h
  · left; rfl
  · right; exact ⟨1, rfl, by norm_num⟩
  · right; exact ⟨2, rfl, by norm_num⟩

-- set
--
-- set a := e with h вводит новое локальное определение a := e и заменяет
-- ВСЕ вхождения выражения e в цели и во всех гипотезах на a. дополнительно
-- добавляет в контекст гипотезу h : a = e (уравнение можно использовать
-- дальше — например, rw [h] чтобы раскрыть a обратно в e).
--
-- главный эффект — свёртывание: было выражение e, разбросанное по цели
-- и гипотезам в нескольких местах, стало короткое имя a везде сразу.
-- это чисто косметическая операция — она не меняет, что доказывается,
-- только то, как это выглядит и как удобно с этим работать дальше.
--
-- синтаксис:
--   set a := e            -- ввести a, заменить e на a везде, без гипотезы-уравнения
--   set a := e with h      -- то же самое + добавить h : a = e в контекст
--   set a := e with ← h    -- добавить h : e = a (уравнение в обратную сторону)
--   set! a := e            -- как set, но не сворачивает e внутри уже
--                             существующих let-выражений (реже нужно)
--
-- отличие от let: let a := e тоже вводит локальное имя, но НЕ ищет и не
-- заменяет вхождения e, которые уже есть в цели/гипотезах — они остаются
-- в развёрнутом виде. set явно проходит по цели и контексту и подставляет
-- a везде, где эта же строка встречается.
--
-- отличие от generalize: generalize a := e тоже заменяет e на новую
-- переменную a в цели, но ЗАБЫВАЕТ связь между a и e (не добавляет
-- уравнение, если явно не попросить через generalize h : e = a) и не
-- трогает гипотезы. set по умолчанию помнит, чему равно a (через h),
-- и подставляет a в гипотезы тоже — это делает его удобнее для
-- "переименовать сложное подвыражение и продолжить работу с ним".
--
-- когда применять:
--   1. в цели или гипотезах несколько раз повторяется одно и то же
--      громоздкое выражение (n ^ 2 + 3 * n, f (g x) и т.п.) — хочется
--      дать ему короткое имя, чтобы цель читалась проще
--   2. дальше по доказательству нужно и работать с коротким именем,
--      и иногда возвращаться к исходному выражению через гипотезу h
--   3. хочется одним действием переписать вхождения выражения сразу
--      и в цели, и во всех гипотезах, где оно встречается

-- пример 1: простейший случай — свернуть одно вхождение в цели
-- было:  ⊢ n + 1 > 0
-- после set a := n + 1 with h:  a : ℕ, h : a = n + 1,  ⊢ a > 0
example (n : ℕ) : n + 1 > 0 := by
  set a := n + 1 with h
  omega

-- пример 2: set сворачивает выражение сразу в нескольких гипотезах,
-- а не только в цели — h1 и h2 меняются одновременно с целью
-- было:  h1 : n * n = 4,  h2 : n * n ≥ 0,  ⊢ n * n + 1 = 5
-- после set a := n * n:  h1 : a = 4,  h2 : a ≥ 0,  ⊢ a + 1 = 5
example (n : ℕ) (h1 : n * n = 4) (h2 : n * n ≥ 0) : n * n + 1 = 5 := by
  set a := n * n
  omega

-- пример 3: гипотеза-уравнение h пригождается, когда нужно вернуться
-- от свёрнутого имени a обратно к исходному выражению
-- после set a := n + m with h цель ⊢ a * 2 = 2 * (n + m) не закрывается
-- напрямую (a непрозрачно) — rw [h] раскрывает a в n + m, дальше ring
example (n m : ℕ) : (n + m) * 2 = 2 * (n + m) := by
  set a := n + m with h
  rw [h]
  ring

-- пример 4: set ← h — уравнение в обратную сторону (h : e = a вместо a = e)
-- иногда удобнее для дальнейшего rw [← h] или rw [h], смотря в какую
-- сторону переписывать; здесь h : n + n = a, и rw [← h] возвращает a → n + n
example (n : ℕ) : n + n = 2 * n := by
  set a := n + n with ← h
  rw [← h]
  ring

-- пример 5: отличие set от let на практике — set видит и заменяет
-- вхождение выражения, которое уже было в гипотезе h0 ДО вызова set;
-- let так делать не умеет, он лишь добавляет новое имя, не трогая h0
-- было:  h0 : n ^ 2 + 1 > 0,  ⊢ n ^ 2 + 1 ≠ 0
-- после set a := n ^ 2 + 1:  h0 : a > 0,  ⊢ a ≠ 0 — оба места свёрнуты
example (n : ℕ) (h0 : n ^ 2 + 1 > 0) : n ^ 2 + 1 ≠ 0 := by
  set a := n ^ 2 + 1
  omega

-- пример 6: сложный случай — вложенное выражение встречается и в цели,
-- и в двух разных гипотезах одновременно; set сворачивает все три места
-- одним действием, дальше вся арифметика ведётся через короткое имя s
-- было:  h1 : n + m ≤ 10,  h2 : n + m ≠ 3,  ⊢ (n + m) + 1 ≤ 11
-- после set s := n + m with h:  h1 : s ≤ 10,  h2 : s ≠ 3,  ⊢ s + 1 ≤ 11
example (n m : ℕ) (h1 : n + m ≤ 10) (h2 : n + m ≠ 3) : (n + m) + 1 ≤ 11 := by
  set s := n + m with h
  omega

-- positivity
--
-- Доказывает цели вида 0 ≤ e, 0 < e и e ≠ 0
-- (тоже самое, что e > 0, e ≥ 0, читая знак в другую сторону).
-- Работает структурно: рекурсивно спускается по построению выражения e
-- (+, *, /, ⁻¹, ^, exp, sqrt, abs, norm, Finset.sum и т.д.)
-- и для каждой операции комбинирует знаки уже разобранных подвыражений.
--
-- Синтаксис:
--   positivity — единственная форма, без аргументов
--
-- Что делает с атомами (переменными, непрозрачными подвыражениями):
-- если дальше разбирать нечего — это просто переменная x или вызов функции,
-- про которую positivity ничего не знает —
-- тактика ищет в контексте гипотезу нужной формы:
-- 0 < x, 0 ≤ x или x ≠ 0.
-- Если такой гипотезы нет — остаётся недоказанным и вся тактика фейлится.
--
-- Что умеет:
--   константы: 0 < 5, 0 ≤ 0
--   чётные степени: 0 ≤ x ^ 2 для любого x, без гипотез о знаке x
--   сумма/произведение/частное: знак результата выводится из знаков частей
--     (например: pos + pos = pos, pos * nonneg = nonneg, pos / pos = pos)
--   специальные функции: Real.exp x > 0 всегда, Real.sqrt x ≥ 0 всегда,
--     |x| ≥ 0 всегда, ‖x‖ ≥ 0 всегда, (n : ℝ) ≥ 0 для n : ℕ
--   расширяется через атрибут @[positivity], как norm_num через @[norm_num]
--
-- Что НЕ умеет:
--   произвольные неравенства между разными выражениями — цель обязана
--   иметь буквально форму 0 ≤ e / 0 < e / e ≠ 0, а не x ≤ y или x = y
--   вычитание над ℝ, ℚ и т.п. — знак a - b структурно не определить
--     (a - b может быть и положительным, и отрицательным в зависимости
--     от соотношения a и b) — для этого нужен linarith/nlinarith
--   произвольные гипотезы вида a ≤ b, a < b — только точные 0 < a / 0 ≤ a / a ≠ 0
--   переносить знание через равенства и посторонние факты — это не linarith,
--   она не ищет линейную комбинацию гипотез, а только спускается по структуре e
--
-- positivity vs nlinarith — когда что брать:
--
--   задача                              positivity   nlinarith
--   ──────────────────────────────────────────────────────────
--   0 ≤ x ^ 2                           ✓            ✓ (нужен sq_nonneg)
--   0 < x ^ 2 + 1                       ✓            ✓ (нужна подсказка)
--   0 < Real.exp x                      ✓            ✗ (не знает exp)
--   x ≤ y  →  0 ≤ y - x                 ✗            ✓
--   x = y  →  0 ≤ x - y ∨ 0 ≤ y - x     ✗            ✓
--
-- правило: если цель — это буквально "знак одного выражения" и это выражение
-- собрано из +, *, /, ^, exp, sqrt, abs — сначала пробуй positivity, она быстрее
-- и не требует подсказок. если нужно сравнить два разных выражения между
-- собой — сразу переходи на linarith/nlinarith.

-- примеры: от простого к сложному.

-- 1. константа:
example : (0 : ℝ) < 5 := by positivity

-- 2. чётная степень — знак x не важен, x ^ 2 всегда ≥ 0:
example (x : ℝ) : 0 ≤ x ^ 2 := by positivity

-- 3. сумма квадрата (≥ 0) и положительной константы (> 0) — итог строго положителен:
example (x : ℝ) : 0 < x ^ 2 + 1 := by positivity

-- 4. атом x требует гипотезы точно нужной формы — positivity находит
-- hx : 0 < x в контексте и складывает с положительной константой:
example (x : ℝ) (hx : 0 < x) : 0 < x + 1 := by positivity

-- 5. произведение — pos * nonneg = nonneg:
example (x y : ℝ) (hx : 0 < x) (hy : 0 ≤ y) : 0 ≤ x * y := by positivity

-- 6. частное — pos / pos = pos:
example (x y : ℝ) (hx : 0 < x) (hy : 0 < y) : 0 < x / y := by positivity

-- 7. цель в форме ≠ 0 — квадрат ненулевого атома строго положителен,
-- значит и не равен нулю:
example (x : ℝ) (hx : x ≠ 0) : x ^ 2 ≠ 0 := by positivity

-- 8. специальная функция — Real.exp строго положительна для любого аргумента,
-- никакая гипотеза про x не нужна:
example (x : ℝ) : 0 < Real.exp x := by positivity

-- 9. составное выражение — три слагаемых, каждое положительно благодаря hx,
-- positivity комбинирует все три знака одновременно:
example (x : ℝ) (hx : 0 < x) : 0 < x ^ 3 + 2 * x + 1 := by positivity

-- 10. сумма разнородных неотрицательных функций — cast из ℕ (≥ 0),
-- |x| (≥ 0) и Real.sqrt x (≥ 0, определён как 0 на отрицательных x) —
-- каждое слагаемое разбирается своим правилом, но итоговая сумма всё равно ≥ 0:
example (n : ℕ) (x : ℝ) : 0 ≤ (n : ℝ) + |x| + Real.sqrt x := by positivity

-- peel
--
-- Бывает, что гипотеза и цель устроены одинаково снаружи —
-- обе начинаются с одного и того же ∀ или ∃ —
-- а отличаются только внутри, глубоко под этими кванторами.
--
-- peel h with x h' убирает этот общий внешний слой и у гипотезы `h`, и у цели:
-- вводит связанную переменную x и кладёт в контекст h' —
-- то, что осталось от h после снятия слоя.
-- Цель при этом тоже теряет свой внешний слой.
-- Остаётся доказать только внутреннюю часть, используя h' —
-- без ручного intro/obtain и без переписывания кванторов вручную.
--
-- Синтаксис:
--   peel h                       — снять с h и цели ВСЕ совпадающие слои сразу;
--                                   переменные получают автоматические имена,
--                                   итоговая гипотеза называется this
--   peel h with x h'             — снять один слой, назвать переменную x,
--                                   а оставшуюся гипотезу h'
--   peel n h with x y z h'       — снять ровно n слоёв, дать имена x, y, z
--                                   связанным переменным по ходу снятия
--   peel h with x y z h'         — то же самое: число слоёв берётся из
--                                   количества переданных имён (x, y, z)
--   peel h with x h' using e     — снять слой и сразу закрыть цель термом e
--                                   (эквивалент peel h with x h'; exact e)
--   peel with x                  — тот же приём для цели вида (∀ x, p x) ↔ ∀ x, q x,
--                                   без отдельной гипотезы — снимает квантор с обеих
--                                   сторон ↔ сразу, оставляя ⊢ p x ↔ q x
--
-- какие слои умеет снимать: ∀, ∃, ограниченные кванторы вида ∃ δ > 0, ...
-- (это просто сахар для ∃ δ, δ > 0 ∧ ...), а также ∀ᶠ (Filter.Eventually)
-- и ∃ᶠ (Filter.Frequently) из теории фильтров.
--
-- важное ограничение: peel делает доказательство ЛОГИЧЕСКИ СЛАБЕЕ —
-- из "h : ∀ x, p x" и "⊢ ∀ x, q x" после peel остаётся доказать "q x" для
-- конкретного (но произвольного) x, используя "p x". Обратное — что из цели
-- можно вывести h — peel не проверяет и не может: это не эквивалентность,
-- а one-way ослабление, которое годится только когда по смыслу задачи
-- одно действительно влечёт другое поточечно.

-- примеры: от простого к сложному.

-- 1. один слой ∀ — hpq работает поточечно,
-- peel сводит цель ровно к тому месту, где hpq нужно применить:
example (p q : ℕ → Prop) (hpq : ∀ x, p x → q x) (h : ∀ x, p x) : ∀ x, q x := by
  peel h with x h'
  exact hpq x h'

-- 2. один слой ∃ — тот же приём, только квантор экзистенциальный:
example (p q : ℕ → Prop) (hpq : ∀ x, p x → q x) (h : ∃ x, p x) : ∃ x, q x := by
  peel h with x h'
  exact hpq x h'

-- 3. peel h без with — снимает все слои сразу, имена автоматические;
-- итоговая гипотеза называется this, переменная получает сгенерированное имя
-- (её всё ещё можно достать через rename_i)
--
-- откуда берётся this : p x✝ — h дословно имеет тип ∀ x, p x. чтобы свести
-- цель ∀ x, q x к чему-то доказуемому, peel вводит ту же самую переменную x
-- (только без имени, отсюда x✝) и добавляет в контекст то, что h знает про
-- неё — p x✝ — под именем this. p здесь ровно та, что в типе h.
-- дальше остаётся доказать q x✝, используя this : p x✝
-- и какую-то связь между p и q (здесь — hpq).
example (p q : ℕ → Prop) (hpq : ∀ x, p x → q x) (h : ∀ x, p x) : ∀ x, q x := by
  -- Чтобы из h : ∀ x, p x получить цель ∀ x, q x, peel действует так:
  -- Он говорит, что вместо ∀ x, q x достаточно доказать ∀ x, p x → q x,
  -- а ∀ x, p x у нас уже есть — это h.
  -- После этого peel сразу же помещает `x`, и посылку `p x` этой импликации в контекст
  -- (посылка называется this, раз имя не задано), а в цели остаётся только q x.
  peel h
  rename_i x
  exact hpq x this

-- 4. ограниченный квантор ∃ δ > 0, P δ — под капотом это ∃ δ, δ > 0 ∧ P δ,
-- поэтому peel снимает сразу и δ, и доказательство δ > 0, и остаток h':
example (P Q : ℝ → Prop) (hPQ : ∀ δ, δ > 0 → P δ → Q δ)
  (h : ∃ δ > (0 : ℝ), P δ) : ∃ δ > (0 : ℝ), Q δ := by
    peel h with δ hδ h'
    exact hPQ δ hδ h'

-- 5. несколько слоёв за один вызов — h и цель совпадают по форме
-- "∀ ε > 0, ∃ N, ∀ n ≥ N, ..." и отличаются только знаком < / ≤ в самом низу.
-- peel снимает все пять слоёв (ε, ε > 0, N, n, n ≥ N) одним вызовом,
-- перечисляя имена по порядку; остаётся только h_peel : ... < ε против цели ... ≤ ε
example (h : ∀ ε > (0 : ℝ), ∃ N : ℕ, ∀ n ≥ N, 1 / (n + 1 : ℝ) < ε) :
  ∀ ε > (0 : ℝ), ∃ N : ℕ, ∀ n ≥ N, 1 / (n + 1 : ℝ) ≤ ε := by
    peel h with ε hε N n hn h_peel
    exact h_peel.le

-- 6. using — снять слой и сразу закрыть цель одним термом,
-- без отдельной строки exact:
example (p q : ℕ → Prop) (hpq : ∀ x, p x → q x) (h : ∀ x, p x) : ∀ x, q x := by
  peel h with x h' using hpq x h'

-- 7. peel на цели-эквивалентности без отдельной гипотезы — цель сама
-- имеет форму (∀ x, p x) ↔ ∀ x, q x, peel with x снимает ∀ с обеих
-- сторон ↔ одновременно, оставляя p x ↔ q x:
example (p q : ℕ → Prop) (hpq : ∀ x, p x ↔ q x) : (∀ x, p x) ↔ ∀ x, q x := by
  peel with x
  exact hpq x

-- rename_bvar
--
-- Переименовывает связанную (bound) переменную — меняет только то имя,
-- которое видно в infoview, саму формулу это не трогает:
-- любые два имени связанной переменной альфа-эквивалентны,
-- и exact/apply это отлично знают сами по себе.
--
-- rename_bvar нужен не для унификации, а для читаемости —
-- когда гипотеза и цель по смыслу говорят об одном и том же,
-- но названы их связанные переменные по-разному, и это режет глаз.
--
-- Синтаксис:
--   rename_bvar old → new         -- переименовать в цели
--   rename_bvar old → new at h    -- переименовать в гипотезе h
--
-- Важно:
--   1. переименовываются ВСЕ связанные переменные с именем old во всём
--      выражении (цели или гипотезы) за один вызов, а не только ближайшая;
--   2. если имени old в выражении нет — тактика молча ничего не делает,
--      это не ошибка;
--   3. переименование затрагивает только ∀ (forallE) и λ (lam) — их выбирает
--      сама реализация тактики, обходя выражение рекурсивно.

-- пример 1: переименование в цели — только косметика, сама формула та же
example (P : ℕ → Prop) (h : ∀ n, P n) : ∀ m, P m := by
  rename_bvar m → n
  -- цель теперь ∀ n, P n — дословно совпадает с h по имени переменной
  exact h

-- пример 2: переименование в гипотезе через at h
example (P : ℕ → ℕ → Prop) (h : ∀ n, ∃ m, P n m) : ∀ l, ∃ m, P l m := by
  rename_bvar n → l at h
  -- h теперь : ∀ l, ∃ m, P l m — то же самое, что и цель, дословно
  exact h

-- пример 3: одно имя — сразу все вхождения переименовываются одним вызовом
-- (n встречается в обеих половинах конъюнкции — обе меняются разом)
example (P Q : ℕ → Prop) (h : (∀ n, P n) ∧ (∀ n, Q n)) :
    (∀ m, P m) ∧ (∀ m, Q m) := by
  rename_bvar n → m at h
  exact h

-- пример 4: имени old нет в выражении — тактика просто ничего не делает
example (P : ℕ → Prop) (h : ∀ n, P n) : ∀ n, P n := by
  rename_bvar z → w  -- z нигде не встречается — цель не изменилась
  exact h

-- пример 5: rename_bvar абсолютно не нужен для exact — Lean сверяет термы
-- по альфа-эквивалентности, а не по именам связанных переменных.
-- вот тот же пример 2, но без единого rename_bvar — работает точно так же
example (P : ℕ → ℕ → Prop) (h : ∀ n, ∃ m, P n m) : ∀ l, ∃ m, P l m := by
  exact h
