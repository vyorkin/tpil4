-- simp — автоматический упрощатель на основе лемм с атрибутом @[simp].
--
-- simp применяет переписывающие правила слева направо в цикле до тех пор,
-- пока не перестанет делать прогресс. Набор правил — это все леммы в Mathlib,
-- помеченные @[simp], плюс то, что передаётся явно.
--
-- Синтаксис:
--   simp                    — использует все @[simp]-леммы
--   simp [h]                — добавляет h к набору правил
--   simp [h₁, h₂, lemma]    — добавляет несколько правил
--   simp [-h]               — исключает конкретную @[simp]-лемму h из набора
--   simp only [h₁, h₂]      — использует ТОЛЬКО перечисленные правила (безопаснее)
--   simp at h               — применяет к гипотезе h
--   simp at h ⊢             — применяет и к гипотезе, и к цели
--   simp_all                — применяет simp ко всем гипотезам и цели одновременно
--
-- simp only [...] vs simp:
--   simp без аргументов применяет тысячи лемм — мощно, но непредсказуемо:
--   новые версии Mathlib могут добавить @[simp]-лемму, которая сломает
--   доказательство. simp only [] явно перечисляет правила — стабильнее.
--   В серьёзных доказательствах рекомендуется simp only.

-- пример 1: простая арифметика
example : 1 + 1 = 2 := by simp

-- пример 2: simp с добавленной гипотезой
example (n : ℕ) (h : n = 0) : n + n = 0 := by simp [h]

-- пример 3: simp only — только конкретные леммы
example (p q : Prop) (hp : p) (hq : q) : p ∧ q := by
  simp only [and_iff_right hp]
  exact hq

-- пример 4: simp at h — упростить гипотезу
example (p : Prop) (h : p ∧ True) : p := by
  simp at h
  exact h

-- пример 5: simp [-add_comm] — исключить конкретную лемму
-- если simp зацикливается из-за правила, можно его отключить через [-имя]
example (a b : ℕ) : a + b = b + a := by
  simp [Nat.add_comm]

-- simp_all
--
-- simp_all — усиленная версия simp [*] at *:
-- упрощает ВСЕ гипотезы и цель одновременно,
-- используя сами гипотезы как дополнительные правила переписывания
-- друг для друга и для цели, и повторяет проход несколько раз —
-- пока хоть что-то ещё меняется (а не один раз, как simp [*] at *).
--
-- Разница между тремя похожими вариантами:
--   simp at *        — упрощает каждую гипотезу и цель ПО ОТДЕЛЬНОСТИ через
--                       @[simp]-набор; гипотезы друг друга не используют.
--   simp [*] at *     — то же самое, но гипотезы участвуют как правила друг
--                       для друга и для цели. Один проход.
--   simp_all          — как simp [*] at *, но проходов несколько, до
--                       фикс-точки: пока применяется хоть одно правило.
--
-- Учитываются только непозависимые пропозициональные гипотезы (h : P,
-- P : Prop, и от h больше ничего не зависит). Обычные переменные вроде
-- n : ℕ сами по себе как правила не используются.
--
-- Синтаксис:
--   simp_all                — упростить все гипотезы и цель до фикс-точки
--   simp_all [h]             — добавить h как ещё одно правило
--   simp_all only [h₁, h₂]   — без @[simp]-набора, только перечисленное
--                              (локальные гипотезы всё равно используются
--                              автоматически — перечислять их снова не нужно)
--   simp_all [-h]            — исключить конкретную @[simp]-лемму h

-- пример 1: гипотеза используется, чтобы переписать другую гипотезу.
-- h1 : p ↔ q переписывает h2 : p в q, а дальше h2 совпадает с целью.
-- Обычный simp at h2 так не сделает — h1 не подключается автоматически,
-- пришлось бы явно писать simp [h1] at h2.
example (p q : Prop) (h1 : p ↔ q) (h2 : p) : q := by
  simp_all

-- пример 2: противоречие в гипотезах закрывает ЛЮБУЮ цель.
-- h1 : n = 0 переписывает h2 : n ≠ 0 в 0 ≠ 0, что упрощается до False —
-- а с False в контексте цель закрывается сама, даже если она никак
-- не связана с n.
example (n : ℕ) (h1 : n = 0) (h2 : n ≠ 0) : 1 = 2 := by
  simp_all

-- пример 3: ради этого и нужны несколько раундов — h1 упрощает h2,
-- а уже обновлённый h2 упрощает цель. За один проход (simp [*] at *
-- в порядке "цель раньше гипотез") могло бы не хватить одного шага.
example (a b c : ℕ) (h1 : a = 0) (h2 : b = a + 1) : b + c = 1 + c := by
  simp_all

-- пример 4: simp_all only — без @[simp]-набора. h : a = b подключается
-- автоматически (это и есть смысл "_all"), а Nat.add_comm добавлена явно,
-- потому что коммутативность не нужна почти нигде и не стоит в @[simp]
example (a b : ℕ) (h : a = b) : a + 1 = 1 + b := by
  simp_all only [Nat.add_comm]

-- simp_rw
--
-- Ведёт себя как цепочка вызовов rw, но добавляет две возможности.
--
-- Первая: каждое вхождение в цели получает собственную подстановку.
--
-- Пусть h : ∀ n, f n = g n, а в цели встречаются f 1 и f 2.
-- Обычный rw [h] находит первое совпадение, фиксирует n := 1 и переписывает
-- только вхождения, совпадающие с этим конкретным n := 1 — f 2 остаётся
-- нетронутым. simp_rw [h] подставляет n := 1 в f 1 и отдельно n := 2 в f 2,
-- за один вызов.
--
-- Вторая: simp_rw переписывает внутри ∀, ∃, λ.
--
-- rw ищет вхождение строго в дереве терма цели,
-- и если оно спрятано под такой конструкцией — не
-- находит его, переписывание там просто не срабатывает.
-- simp_rw находит вхождение и переписывает его на месте, даже под биндером.
--
-- От полного simp отличается тем, что применяет только перечисленные леммы,
-- строго по порядку слева направо — каждую до фикс-точки, прежде чем перейти
-- к следующей. Никакого перебора по @[simp]-набору — предсказуем как rw.
--
-- Синтаксис:
--   simp_rw [h]              — переписать по h везде, где возможно, до фикс-точки
--   simp_rw [h₁, h₂]         — сначала h₁ до конца, потом h₂ до конца
--   simp_rw [← h]            — переписать в обратную сторону
--   simp_rw [h] at h'        — применить к гипотезе h'

-- пример 1: несколько разных инстанциаций сразу —
-- h : ∀ n, f n = g n нужно переписать и f 1, и f 2, с разными n.
-- rw [h] находит первое совпадение (n := 1),
-- переписывает f 1 → g 1, а f 2 не трогает —
-- остаётся незакрытая цель g 1 + f 2 = g 1 + g 2.
-- simp_rw [h] переписывает каждое вхождение своей инстанциацией n:
example (f g : ℕ → ℕ) (h : ∀ n, f n = g n) : f 1 + f 2 = g 1 + g 2 := by
  simp_rw [h]

-- пример 2: переписывание под биндером λ — rw [h] тут вообще падает
-- с ошибкой "Did not find an occurrence of the pattern f ?n" в цели
-- (fun n ↦ f n + 1) = fun n ↦ g n + 1, потому что f n стоит внутри лямбды
-- и rw не ищет вхождения под связыванием.
-- simp_rw заходит внутрь лямбды и переписывает f n → g n на месте:
example (f g : ℕ → ℕ) (h : ∀ n, f n = g n) :
  (fun n => f n + 1) = fun n => g n + 1 := by
    simp_rw [h]

