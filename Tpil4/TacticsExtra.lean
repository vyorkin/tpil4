-- rcases
--
-- Тактика rcases позволяет рекурсивно распаковывать всякие
-- определения и выражения, именно поэтому "эр"-кейсэс (r - recursive).
--
-- Суть в том, что обычный cases делает один "уровень" разбора,
-- а rcases делает сразу столько уровней вложенности, сколько ты описал в паттерне.
-- Это экономит несколько строк cases/obtain и избавляет от кучи промежуточных имён.
--
-- Базовые паттерны:
--
--   ⟨x, hx⟩         — распаковать пару / ∃ x, P x (один уровень)
--   h | h'           — разобрать дизъюнкцию на две ветки
--   ⟨x, h1, h2⟩     — тройка / ∃ x, P x ∧ Q x (один уровень, два факта)
--   ⟨x, ⟨h1, h2⟩⟩   — два уровня вложенности
--   -                — игнорировать компоненту (как _ в паттерн-матчинге)
--   rfl              — компонента оказалась равенством — подставить сразу
--
-- Пример 1: распаковать ∃
--
--   example (h : ∃ n : ℕ, n > 5) : True := by
--     rcases h with ⟨n, hn⟩
--     -- теперь в контексте n : ℕ и hn : n > 5
--     trivial
--
-- Пример 2: разобрать дизъюнкцию
--
--   example (h : P ∨ Q) : Q ∨ P := by
--     rcases h with hp | hq
--     · right; exact hp   -- ветка P
--     · left;  exact hq   -- ветка Q
--
-- Пример 3: ∃ x, P x ∧ Q x — сразу до двух фактов
--
--   example (h : ∃ n : ℕ, n > 0 ∧ n < 10) : True := by
--     rcases h with ⟨n, hn_pos, hn_lt⟩
--     -- n : ℕ, hn_pos : n > 0, hn_lt : n < 10
--     trivial
--
-- Пример 4: вложенная дизъюнкция в конъюнкции
--
--   example (h : (P ∨ Q) ∧ R) : R := by
--     rcases h with ⟨hp | hq, hr⟩
--     · exact hr   -- ветка P ∧ R
--     · exact hr   -- ветка Q ∧ R
--
-- rcases — обёртка над obtain, которая в свою очередь — обёртка над cases + intro.
-- Вся мощь в том, что паттерн рекурсивный: любой ⟨...⟩ внутри раскрывается
-- на следующий уровень без дополнительных тактик.

-- rintro
--
-- Тактика rintro = intro + rcases. Почти как intro, только мощнее.
-- Позволяет рекурсивно распаковывать всякие определения и
-- выражения, именно поэтому "эр"-кейсэс (r - recursive).
--
-- Разница с intro + rcases:
--
--   intro h; rcases h with ⟨x, hx⟩   -- два шага
--   rintro ⟨x, hx⟩                    -- один шаг, эквивалентно
--
-- rintro особенно удобен, когда вводишь сразу несколько аргументов с распаковкой.
--
-- Пример 1: ввести пару из ∃
--
--   example : (∃ n : ℕ, n > 5) → True := by
--     rintro ⟨n, hn⟩
--     -- n : ℕ, hn : n > 5 — оба сразу в контексте
--     trivial
--
-- Пример 2: ввести дизъюнкцию (паттерн с |)
--
--   example : P ∨ Q → Q ∨ P := by
--     rintro (hp | hq)
--     · right; exact hp
--     · left;  exact hq
--
-- Пример 3: вложенная структура — ∃ x, P x ∧ Q x → ...
--
--   example : (∃ n : ℕ, n > 0 ∧ n < 10) → True := by
--     rintro ⟨n, hn_pos, hn_lt⟩
--     trivial
--
-- Пример 4: конъюнкция с дизъюнкцией внутри
--
--   example : (P ∨ Q) ∧ R → R := by
--     rintro ⟨hp | hq, hr⟩ <;> exact hr
--
-- Паттерны rintro те же, что и у rcases:
--   ⟨a, b⟩   — пара / ∃
--   a | b     — дизъюнкция (ветвит доказательство)
--   rfl       — равенство — сразу подставить
--   -         — игнорировать

-- Можно использовать к дизъюнкцией.
--
-- example : s ∪ (⋂ i, A i) = ⋂ i, A i ∪ s := by
--   ext x
