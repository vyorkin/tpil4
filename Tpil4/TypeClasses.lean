-- 10. Type Classes

-- Класс типов (type class) — это механизм ad-hoc полиморфизма в Lean 4.
-- Идея пришла из Haskell, но в Lean она органично встраивается в зависимые типы.
--
-- Синтаксически "class" это то же самое, что "structure", но с одним важным дополнением:
-- Lean будет автоматически искать (синтезировать) экземпляр (instance) нужного класса,
-- когда функция требует его через аргумент в квадратных скобках [ClassName α].
-- Поиск инстансов (instance search / instance synthesis) — ключевая особенность классов типов.
--
-- Отличие от structure:
--   structure Foo where field : Nat   -- просто тип данных, экземпляр нужно передавать явно
--   class    Bar where field : Nat    -- то же, но Lean умеет находить экземпляр сам
--
-- Квадратные скобки в сигнатуре функции:
--   def f [Add α] ...   -- [Add α] — неявный аргумент-экземпляр, Lean синтезирует его автоматически
--   def g {α : Type} ...  -- {α} — неявный аргумент-тип, выводится из контекста, но НЕ ищется как инстанс
--
-- Когда Lean видит [Add α], он просматривает все видимые instance-декларации в текущей области,
-- ищет среди них такую, которая подходит для конкретного α, и "подставляет" найденный инстанс.
-- Если подходящего инстанса нет — ошибка компиляции "failed to synthesize instance".

namespace My1

class Add (α : Type) where
  add : α → α → α

#check @Add.add

-- Инстансы — это конкретные "свидетели" того, что некоторый тип принадлежит данному классу.
-- Здесь мы говорим Lean: "Nat, Int и Float умеют складываться".
-- Каждое объявление "instance" добавляет в базу данных инстансов новую запись.
instance : Add Nat where
  add := Nat.add

instance : Add Int where
  add := Int.add

instance : Add Float where
  add := Float.add

-- [Add α] в квадратных скобках означает: "чтобы вызвать double, нужен инстанс Add α —
-- Lean найдёт его сам, не требуй его явно от пользователя".
-- При вызове `double 10` (где 10 : Nat) Lean ищет `Add Nat`, находит наш инстанс выше
-- и подставляет его неявно. Пользователь видит только `double 10`.
def double [Add α] (x : α) : α :=
  Add.add x x

#check @double -- {α : Type} → [Add α] → α → α

#eval double 10
#eval double (10 : Int)
#eval double (10 : Float)
#eval double (239.0 + 2)

-- Инстансы могут зависет от других инстансов.

-- instance [Add α] : Add (Array α) where
--   add x y := Array.zipWith (fun a b => a + b) x y

-- Т.е. классы типов можно использовать для перегрузки нотаций:

-- #eval Add.add #[1, 2] #[3, 4]
-- #[4, 6]

-- #eval #[1, 2] + #[3, 4]
-- #[4, 6]

-- Inhabited это как Default в Rust.
-- Тип α является обитаемым (inhabited), если в нём существует хотя бы один элемент.
-- Это формализует "у типа есть значение по умолчанию", без которого нельзя,
-- например, написать функцию `head : List α → α` — ведь что возвращать для пустого списка?
class Inhabited (α : Type u) where
  default : α

#check Inhabited.default

-- Это полезный тайпкласс. Иногда нам нужен факт обитаемости.
-- Например, для типа непустых списков, ну или для ∃ x : α, x = x
-- требуется, чтобы тип α был обитаем по крайней мере одним x.

-- Базовые инстансы: фиксируем конкретные "обитатели" для примитивных типов.
-- true — каноническое значение Bool, 0 — Nat, () — Unit, True — Prop.
instance : Inhabited Bool where default := true
instance : Inhabited Nat where default := 0
instance : Inhabited Unit where default := ()
instance : Inhabited Prop where default := True

-- Можно вытащить default из неймспейса наружу, это удобно.
-- После export мы можем писать просто `default` вместо `Inhabited.default`.
-- Lean сам поймёт, что нужен инстанс Inhabited, смотря на ожидаемый тип выражения.
export Inhabited (default)

#eval (default : Nat)  -- 0
#eval (default : Bool) -- true

end My1

-- Chaining instances ("цепочки инстансов")
--
-- Поиск инстансов в Lean рекурсивен: если нужный инстанс сам зависит от других инстансов,
-- Lean рекурсивно ищет их тоже. Это называется "chaining" (выстраивание цепочки).
-- Например, чтобы синтезировать `Inhabited (Nat × Bool)`, Lean:
--   1. Видит инстанс `[Inhabited α] [Inhabited β] : Inhabited (α × β)`.
--   2. Подставляет α := Nat, β := Bool.
--   3. Ищет `Inhabited Nat` — находит.
--   4. Ищет `Inhabited Bool` — находит.
--   5. Строит итоговый инстанс из двух найденных.
-- Всё это происходит автоматически, без участия программиста.

namespace My2

-- Пара (α × β) обитаема, если оба компонента обитаемы.
-- Оба аргумента в квадратных скобках — это зависимости, которые Lean цепочит автоматически.
instance [Inhabited α] [Inhabited β] : Inhabited (α × β) where
  default := (default, default)

#eval (default : Nat × Bool) -- (0, false)

-- Функция (α → β) обитаема, если β обитаема: можно вернуть константную функцию `λ _ => default`.
-- Заметь: α не обязан быть обитаемым — мы просто игнорируем аргумент.
instance [Inhabited β] : Inhabited (α → β) where
  default := λ _ => default

-- Список всегда обитаем — пустой список `[]` есть всегда, для любого α.
instance : Inhabited (List α) where
  default := List.nil

-- Для суммы (α ⊕ β) достаточно обитаемости α: берём Sum.inl default.
-- Выбор "левой" ветки здесь произвольный — главное, что значение существует.
instance [Inhabited α] : Inhabited (Sum α β) where
  default := Sum.inl default

-- inferInstance — встроенная функция, которая просит Lean синтезировать инстанс
-- того класса типов, который явно указан в аннотации типа.
-- Это удобно когда нужно "достать" инстанс как значение, а не использовать поле класса.
-- Сигнатура:
 -- inferInstance.{u} {α : Sort u} [i : α] : α
 --                                   ^
 --                         instance of typeclass α
#check inferInstance

-- Здесь мы явно говорим Lean: "синтезируй мне Inhabited Nat".
-- Lean находит нужный инстанс и возвращает его как значение.
#check (inferInstance : Inhabited Nat)

-- foo — это инстанс Inhabited (Nat × Nat), синтезированный автоматически.
-- Lean применяет цепочку: Inhabited (Nat × Nat) ← Inhabited Nat × Inhabited Nat.
def foo : Inhabited (Nat × Nat) := inferInstance

-- Почему это rfl (definitional equality, "по вычислению")?
-- foo.default раскрывается до (default, default) прямо по определению инстанса выше.
-- Lean проверяет равенство редукцией (нормализацией): оба терма вычисляются к одному значению.
-- rfl — это доказательство вида `a = a`; оно работает, когда оба терма
-- дефиниционно равны (т.е. один и тот же нормальный вид).
theorem ex : foo.default = (default, default) := rfl

end My2

-- ToString
--
-- Класс типов ToString определяет, как значение типа α превращается в строку.
-- Именно его использует #eval "под капотом": когда ты пишешь `#eval expr`,
-- Lean вызывает `toString expr` — а значит, ищет инстанс `ToString (тип expr)`.
-- Если инстанса нет, #eval выдаст ошибку синтеза инстанса.
-- Это прямой аналог типажа Display в Rust или метода __str__ в Python.

namespace My3

-- Структура Person — обычный record без каких-либо специальных возможностей.
-- По умолчанию Lean не знает, как её печатать: нужен инстанс ToString.
structure Person where
  name : String
  age  : Nat

-- Объявляем инстанс: описываем, как именно Person превращается в строку.
-- После этого #eval, toString и интерполяция строк s!"..." работают с Person.
instance : ToString Person where
  toString p := p.name ++ "@" ++ toString p.age

def vasya := { name := "skufidon Vasya", age := 40 : Person }

-- #eval использует ToString Person, который мы только что объявили.
-- Для пары (vasya, "is learning lean4") Lean ищет ToString (Person × String) —
-- в стандартной библиотеке есть инстанс ToString для пар через ToString компонентов.
#eval toString vasya
#eval (vasya, "is learning lean4")

-- Структура Rational с инвариантом внутри типа (зависимое поле).
-- inv : den ≠ 0 — это не просто "комментарий" или "проверка в рантайме".
-- Это зависимое поле (dependent field): его тип зависит от значения предыдущего поля den.
-- Иными словами, доказательство "знаменатель не ноль" является частью самого значения типа.
-- Создать Rational с den = 0 буквально невозможно — Lean не даст скомпилировать такой код,
-- ведь нужно будет предоставить значение типа (0 ≠ 0), то есть доказательство лжи.
-- Это мощная идея: инварианты, которые обычно проверяются в рантайме,
-- становятся гарантиями времени компиляции.
structure Rational where
  num : Int
  den : Nat
  inv : den ≠ 0

-- Если хочешь, чтобы твой тип мог парситься из числовых литералов,
-- то его нужно сделать инстансом класса типов OfNat.
#eval (2 : Nat)
-- Когда ты пишешь `2 : α`, линь "под капотом" попробует синтезировать
-- инстанс `OfNat α 2` и сгенерирует терм вида `OfNat.ofNat 2 : α`.
--
-- Тепреь глянь на него внимательно:
-- `OfNat.ofNat 2 : α`
--          ^   ^
--        Здесь 2 это не тоже самое, что и просто `2`.
--        Именно тут это `nat_lit 2`. И "это другое".
--
-- Макрос `nat_lit n` конструирует вот эти "сырые числовые литералы".
-- "Сырые" в том смысле, что они соотвествуют `Expr.lit (.natVal n)`,
-- и для них линь не пытается (ещё раз) сделать `OfNat.ofNat 2 : α`.
-- Ну ты понял, да? Ведь обычно (как только что было упомянуто выше),
-- когда ты пишешь числовой литерал `#check 2`, парсер превращает
-- просто число `2` в применение `OfNat.ofNat` к этому твоему числу `2` и
-- приводит это к целевому типу, даже если это тот же Nat
-- (в таком случае приведение типа это id: Nat → Nat).
-- Иметь возможность написать "сырой числовой литерал" необходимо
-- в том числе и потому, что иногда нам нужно строить утверждения и
-- рассуждать непосредственно об этих "сырых числовых литералах".
-- Особенно, если мы доказываем какие-то свойства про саму функцию `ofNat`.

-- Т.е. более корректно было бы сказать, что линь, когда видит `2 : α`
-- пробует синтезировать инстанс `OfNat α (nat_lit 2)` и сгенерирует терм
-- вида `OfNat.ofNat (nat_lit 2) : α`

instance : OfNat Rational n where
  ofNat := { num := n, den := 1, inv := by decide }

instance : ToString Rational where
  toString r := s!"{r.num}/{r.den}"

#eval (2 : Rational)
#eval (2 : Nat)

#check nat_lit 2

-- Давай ради прикола ещё один пример для OfNat напишем.
-- Пусть у нас будет тип, который представляет собой целочисленный
-- интервал от а до a + 5: [a, a + 5].

structure Range5 where
  a : Int
  b : Int

instance : OfNat Range5 n where
  ofNat := { a := n, b := n + 5 }

instance : Add Range5 where
  add x y := Range5.mk (x.a + y.a) (x.b + y.b)

-- instance : ToString Rational where
--   toString r := s!"{r.num}/{r.den}"

instance : ToString Range5 where
  toString r := s!"[{r.a}, {r.b}]"

#check (2 : Range5)
#eval toString (2 : Range5) -- "[2, 7]"

-- Моноид — алгебраическая структура: множество с ассоциативной бинарной операцией и нейтральным элементом.
-- unit — нейтральный элемент (единица моноида): op unit x = x и op x unit = x.
-- op — ассоциативная бинарная операция.
-- Lean не проверяет аксиомы (ассоциативность, нейтральность) автоматически —
-- это просто структура данных; законы нужно доказывать отдельно, если они нужны.
class Monoid (α : Type u) where
  unit : α
  op : α → α → α

-- Инстанс OfNat α _ параметризирован числом (литералом).
--                 ^ - речь про этот вот второй параметр (на месте подчёркивания).
-- Поэтому можно определять отдельные инстансы для конкретных чисел.
-- Второй аргумент обычно бывает переменной, как в примере выше,
-- или просто натуральным числом.

-- Почему здесь используется nat_lit 1, а не просто n или 1?
-- OfNat α n — инстанс параметризован по конкретному числу n.
-- Если написать `instance [s : Monoid α] : OfNat α n`, это даёт
-- числовой литерал для ЛЮБОГО n, то есть 1 = unit, 42 = unit, 1000 = unit.
-- Это слишком широко и математически неверно.
-- Написав `nat_lit 1`, мы ограничиваемся ровно числом 1 — нейтральным элементом.
-- Это разумно: в любом моноиде именно 1 принято обозначать нейтральный элемент.
-- Благодаря этому инстансу можно писать `(1 : α)` вместо `Monoid.unit`,
-- что делает нотацию привычной и читаемой.

-- instance [s : Monoid α] : OfNat α n where
instance [s : Monoid α] : OfNat α (nat_lit 1) where
  ofNat := s.unit

-- getUnit демонстрирует что теперь для любого моноида число 1 синтаксически
-- означает нейтральный элемент: Lean видит `1`, ищет OfNat α (nat_lit 1),
-- находит наш инстанс, раскрывает его до s.unit.
def getUnit [Monoid α] : α := 1

end My3

-- 10.4 Output Parameters ("выходные параметры")
-- Обычно все параметры класса типов являются "входными": они известны до поиска инстанса.
-- Иногда полезно пометить параметр как "выходной" (outParam), чтобы Lean мог вывести его
-- из контекста уже в процессе синтеза инстанса, а не требовал задать его заранее.
-- Классический пример — HAdd (гетерогенное сложение):
--   class HAdd (α β : Type) (γ : outParam Type) where
--     hAdd : α → β → γ
-- Здесь γ — выходной параметр. Lean ищет инстанс HAdd α β по α и β,
-- а тип результата γ определяется самим инстансом как "выход".
-- Это позволяет писать `x + y` и получать правильный тип результата без явного указания.
-- Без outParam Lean жаловался бы на неоднозначность при синтезе инстанса.
-- Раздел не заполнен кодом: тема хорошо иллюстрируется стандартными классами HAdd/HMul из prelude.

namespace My4
end My4

-- 10.5 Default Instances ("инстансы по умолчанию")
-- Когда для синтеза есть несколько подходящих инстансов, Lean использует приоритеты.
-- Атрибут @[defaultInstance] (или параметр priority := N) позволяет указать,
-- какой инстанс предпочесть при прочих равных.
-- Например, если написать числовой литерал `2` без аннотации типа,
-- Lean должен выбрать какой-то "дефолтный" числовой тип. В стандартной библиотеке
-- именно через defaultInstance задаётся, что голый `2` имеет тип Nat, а не Int или Float.
-- Приоритет (priority) — натуральное число: чем больше, тем предпочтительнее инстанс.
-- Инстансы без явного приоритета имеют некоторый дефолтный уровень (обычно 1000).
-- Раздел не заполнен кодом: тема хорошо видна на примере propDecidable в My9 (priority := low).

namespace My5
end My5

-- 10.6 Local Instances ("локальные инстансы")
-- Иногда нужен инстанс только внутри конкретного определения или блока,
-- без глобальной регистрации. Для этого используется ключевое слово "local":
--   local instance : Foo α where ...
-- Такой инстанс виден только до конца текущего раздела (section/namespace) или файла.
-- Это важно, когда один и тот же тип может иметь несколько математически разных инстансов,
-- и глобальная регистрация всех создала бы конфликт или неоднозначность.
-- Пример: для Nat можно определить моноид по сложению (unit=0, op=+)
-- и моноид по умножению (unit=1, op=*). Оба нужны, но нельзя регистрировать их глобально одновременно.
-- Раздел оставлен пустым; тема раскрывается в контексте конкретных алгебраических задач.

namespace My6
end My6

-- 10.7 Scoped Instances ("инстансы с областью видимости")
-- Scoped instance отличается от local instance: он регистрируется глобально,
-- но активируется только когда пользователь пишет "open ИмяНеймспейса".
-- Синтаксис:
--   scoped instance : Foo α where ...
-- Это позволяет поставлять инстанс "в комплекте" с неймспейсом,
-- не засоряя глобальную базу инстансов по умолчанию.
-- Пример из My9: `noncomputable scoped instance (priority := low) propDecidable` —
-- инстанс активируется только после `open Classical`.
-- Этот механизм часто используется в математических библиотеках (Mathlib):
-- например, кольцевая структура на каком-то типе объявляется scoped,
-- чтобы не конфликтовать с другими интерпретациями того же типа.
-- Раздел оставлен пустым — тема иллюстрируется примером в My9 ниже.

namespace My7
end My7

-- 10.8 Decidable Propositions

-- Имеет смысл сначала прочитать:
-- https://en.wikipedia.org/wiki/Decidability_(logic)

-- Вычислительная разрешимость (Decidability) это не аксиома.
-- Если ты хочешь раскидывать какие-то утверждения по кейсам (p ∨ ¬p),
-- то в конструктивной логике (ну короче всегда) ты должен ввести гипотезу
-- о разрешимости p, проще говоря, сделать p инстансом Decidable.
-- Или ещё проще: Decidable p → ... your goal ...

-- Чтобы вообще было справедливо использовать исключенное третье (em),
-- и рассуждать в духе "или p истина или p ложь", p должно быть Decidable.

-- Decidable - класс типов "разрешимых" высказываний, он определён в стандартной библиотеке.
-- Грубо говоря, элемент типа Prop называется разрешимым, если можно (алгоритмически, конструктивно)
-- определить, истинно оно или ложно.
-- Вот тут понятнее и подробнее можно почитать:
-- https://ru.wikipedia.org/wiki/%D0%97%D0%B0%D0%B4%D0%B0%D1%87%D0%B0_%D1%80%D0%B0%D0%B7%D1%80%D0%B5%D1%88%D0%B8%D0%BC%D0%BE%D1%81%D1%82%D0%B8
-- Это различие имеет смысл только в конструктивной логике.
-- В классической логике любое высказывание считается разрешимым.
-- Однако, если воспользоваться классической логикой, (например, при определении функции),
-- то такая функция уже не будет вычислимой. С алгоритмической точки зрения
-- класс типов [Decidable] позволяет вывести процедуру, которая эффективно определяет,
-- истинно ли данное высказывание. Таким образом, этот класс типов поддерживает
-- вычислимые определения, когда это возможно, и при этом обеспечивает плавный переход к
-- использованию классических определений и рассуждений.

namespace My8

class inductive Decidable (p : Prop) where
  | isFalse (h : ¬p) : Decidable p
  | isTrue  (h :  p) : Decidable p

-- Ну вот, чтобы вообще можно было рассматривать выражения типа
-- if p then e₁ else e₂, то (p : Prop) должно быть разрешимо.
-- Это значит должен существовать вычислительный способ
-- установить истинность или ложность p.

-- ite - if then else
-- if (Decidable c) then t else f
def ite
    {α : Sort u}
    (c : Prop) [h : Decidable c]
    (t f : α) : α :=
  h.casesOn
    (motive := fun _c => α) -- Decidable c -- condition
    (fun _hnc => f) -- ветка false
    (fun _hc  => t) -- ветка true

-- В dite (dependent if then else) аргументы это функции,
-- а в ite аргументы это значения.

def dite
    {α : Sort u}
    (c : Prop) [h : Decidable c]
    (t :     c → α)
    (f : Not c → α) : α :=
  Decidable.casesOn (motive := fun _c => α) h f t

--  if h : c then t else e
--      это сахар для
-- dite c (fun h : c => t h) (fun h : ¬c => e h)

-- instDecidableAnd
--   {p q : Prop}
---  [dp : Decidable p]
--   [dq : Decidable q]
--   : Decidable (p ∧ q)
#check instDecidableAnd

#check instDecidableOr
#check instDecidableNot

def step (a b x : Nat) : Nat :=
  if x < a ∨ x > b then 0 else 1

set_option pp.explicit true
#print step

